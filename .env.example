# 작성: 2026-11-19 10:52 KST
# 필요한 환경 변수 이름 목록(값은 비워 둔다). 이 파일을 .env로 복사해 값을 채운다.
# .env는 저장소에 올리지 않는다(.gitignore에서 제외됨).

# Supabase Postgres 연결 주소. Vercel에서는 Transaction pooler 주소(포트 6543)를 쓴다.
DATABASE_URL=

# OpenRouter API 키. 서버 코드에서만 읽는다.
OPENROUTER_API_KEY=

# Auth.js 세션 암호화용 비밀 문자열(무작위로 길게 만든다).
AUTH_SECRET=

# 구글 로그인용 OAuth 클라이언트 ID(Google Cloud Console에서 발급).
AUTH_GOOGLE_ID=

# 구글 로그인용 OAuth 클라이언트 비밀값.
AUTH_GOOGLE_SECRET=
