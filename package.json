{
    "name":  "ai-empathy-diary",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "db:snapshot":  "node --env-file-if-exists=.env scripts/db-snapshot.mjs",
                    "db:migrate":  "node --env-file-if-exists=.env scripts/db-migrate.mjs",
                    "db:compare":  "node scripts/db-compare.mjs",
                    "db:smoke":  "node --env-file-if-exists=.env scripts/db-smoke.mjs"
                },
    "dependencies":  {
                         "next":  "16.4.6",
                         "next-auth":  "^5.0.0-beta.32",
                         "postgres":  "^4.1.1",
                         "react":  "19.3.0",
                         "react-dom":  "19.3.0"
                     },
    "devDependencies":  {
                            "@tailwindcss/turbopack":  "4.3.3",
                            "@types/node":  "^24.19.2",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.4.6",
                            "tailwindcss":  "4.3.3",
                            "typescript":  "^5",
                            "vitest":  "^5.1.1"
                        }
}
